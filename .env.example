# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Optional canonical URL for server-side integrations.
APP_URL="https://kishan-saathi-nine.vercel.app"

# SESSION_SECRET: A unique, long random value used only by the legacy API session layer.
SESSION_SECRET="GENERATE_A_UNIQUE_LONG_RANDOM_VALUE"

# GOOGLE_CLIENT_ID: Optional Google OAuth 2.0 Web Client ID for live Google Sign-In.
# If not configured, Kisan Saathi provides seamless sandbox/demo authentication and test profiles.
GOOGLE_CLIENT_ID=""

# DATABASE_STORAGE_PATH: Local-development path only. Vercel's filesystem is ephemeral.
DATABASE_STORAGE_PATH="./data/kisan_saathi.db.json"

# DATABASE_AUTO_SEED: Whether to automatically seed database on startup if empty (true/false).
DATABASE_AUTO_SEED="true"

# ==========================================
# FIREBASE CONFIGURATION (AUTHENTICATION & FIRESTORE)
# ==========================================
# Get these keys from: https://console.firebase.google.com/
# Project Overview -> Project Settings -> General -> "Your apps" -> Web SDK configuration
VITE_FIREBASE_API_KEY="AIzaSy..."
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"
